    <string name="about_version">Day Budget %1$s</string>
    <string name="about_privacy">Your data never leaves this phone: no account, no server, no analytics. Everything is stored in one database you can export at any time.</string>
    <string name="about_export">The export is a SQLite file with your priorities, every session split by day, per-day totals, and the raw event history. The schema is versioned and documented in the repository.</string>
    <string name="about_licences">Built with Kotlin, Jetpack Compose, Material Design 3, Room, Hilt, and kotlinx.serialization (Apache 2.0, and their notices).</string>
    <string name="export_history">Export history</string>
    <string name="onboarding_ring_title">Give every day a plan</string>
    <string name="onboarding_ring_body">Each priority you care about gets a budget. The ring shows your whole planned day: bright colour is still yours, dark tint is spent. The biggest remaining slice comes first, so what you\'re neglecting stands out.</string>
    <string name="onboarding_gestures_title">Tap to run, long-press for more</string>
    <string name="onboarding_gestures_body">Tap a colour to run it; tap it again to stop. Only one clock runs at a time. Long-press to log time, edit, or delete.</string>
    <string name="onboarding_alerts_title">Never miss the moment</string>
    <string name="onboarding_alerts_body">When a budget runs out, a real alarm rings: choose Stop, or Keep going into overtime. Allow alerts so you can\'t miss it.</string>
